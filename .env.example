# TradeProof environment variables — TEMPLATE ONLY. No real values here.
# The MOCK demo (npm run mock:start) needs NONE of these: it forces MOCK extraction, MOCK Copilot, MOCK PayPal and a
# separate database, and overrides anything in .env.local. Copy this file to `.env.local` (ignored by Git) only if you
# intend to use real services with `npm run dev` on the main database (docs/run-guide.md §9).
# Every value below is empty or a safe default: with this file as is, no model, no Copilot explanation and no payment
# is enabled. Never paste real values into chat, commits, screenshots or reports.

# ---------- Database ----------
# Empty = the main database data/sandbox-payments.sqlite (Git-ignored). Set to another file to run on a copy.
# Sandbox payments run only on the main database; MOCK payments only on another file.
TRADEPROOF_DB_PATH=
# Used only by npm run mock:* (scripts/local-mock.mjs), read from the TERMINAL environment, not from this file.
# Empty = data/mock/tradeproof-mock.sqlite. The main file is refused.
TRADEPROOF_MOCK_DB=

# ---------- Switches (server-side; the browser cannot change them) ----------
# Approval payments: empty = OFF (every payment step answers 409), "sandbox" = real PayPal Sandbox (main database only),
# "mock" = simulated PayPal, no network (only with TRADEPROOF_DB_PATH on another file).
TRADEPROOF_APPROVAL_PAYMENTS=
# Copilot explanations by a real model: only when exactly "on" AND the model + budget below are configured.
TRADEPROOF_COPILOT_LIVE=

# ---------- PayPal (Sandbox only) ----------
# Must be exactly "sandbox". The server refuses any other value; there is no Live code path.
PAYPAL_ENVIRONMENT=sandbox
# Optional. If set, must be the Sandbox URL below (anything else is refused).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# From developer.paypal.com > Apps & Credentials (Sandbox) > your REST app (owned by the Sandbox Business account).
# PAYPAL_CLIENT_ID is public by design; the server passes it to the demo page. PAYPAL_CLIENT_SECRET stays on the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Account ID (merchant ID) of the Sandbox Business account that owns the app = the fixed test supplier / payee.
# developer.paypal.com > Testing Tools > Sandbox Accounts > the Business account > Account ID (13 letters/digits).
# A capture is only marked PAID if PayPal reports this payee.
PAYPAL_EXPECTED_PAYEE_MERCHANT_ID=
# Webhook ID (not used: no webhook listener is implemented; payments are verified by the server after capture).
PAYPAL_WEBHOOK_ID=

# ---------- Product AI (runtime, not the coding assistant) ----------
# Model TradeProof calls at runtime to extract quotes (and, with the Copilot switch, to explain facts).
# Empty AI_PROVIDER = not configured (nothing is called). "mock" = canned SYNTHETIC output, local development only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Live provider (owner-approved 25 Oct 2026): AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-5-5 (the only
# model accepted for anthropic), AI_API_KEY = your own key. Values for the approved budget and the verified
# prices: docs/quote-extraction.md "Live model (Anthropic)" → Configuration.
# Overall API budget for real model calls (docs/quote-extraction.md "API budget"). Every value is
# required; anything missing refuses real calls. Fill in only after the owner approves the provider,
# model, billing currency and spend. Amounts are decimals in AI_BUDGET_CURRENCY (no conversion).
# AI_BUDGET_APPROVED must be exactly "yes". AI_PRICE_PROVIDER / AI_PRICE_MODEL must equal AI_PROVIDER /
# AI_MODEL. Token prices are per 1,000,000 tokens and must be > 0; AI_PRICE_PER_REQUEST may be 0.
AI_BUDGET_APPROVED=
AI_BUDGET_CURRENCY=
AI_BUDGET_TOTAL_LIMIT=
AI_BUDGET_DAILY_LIMIT=
AI_BUDGET_TOTAL_MAX_CALLS=
AI_BUDGET_DAILY_MAX_CALLS=
AI_PRICE_PROVIDER=
AI_PRICE_MODEL=
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_PER_REQUEST=

# ---------- App ----------
# Base URL for return/cancel links during local development (the dev server binds 127.0.0.1:3000).
APP_BASE_URL=http://localhost:3000
